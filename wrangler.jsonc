{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-reza",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "36f590ef-e21d-4573-b658-ff26a25f4708","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f3941273e7734b2f852b4b091c268ddf" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
